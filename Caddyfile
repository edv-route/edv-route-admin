# Serves the Angular SPA. Railway terminates TLS at its proxy, so Caddy only
# needs plain HTTP on the injected $PORT. try_files routes every unknown path
# to index.html so Angular's client-side router owns navigation (deep links,
# reloads). Hashed assets are safe to cache long-term.
{
	admin off
	auto_https off
}

:{$PORT:80} {
	root * /srv
	encode gzip zstd
	try_files {path} /index.html
	file_server

	@immutable path *.js *.css *.woff2 *.ttf *.png *.jpg *.svg *.ico
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}
